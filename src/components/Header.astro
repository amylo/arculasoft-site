---
import Logo from './Logo.astro';
import { site } from '../lib/site';

const links = [
  { href: '/#features', label: 'Features' },
  { href: '/release-notes/', label: "What's new" },
  { href: '/privacy/', label: 'Privacy' },
];
---

<header class="header">
  <div class="container inner">
    <a href="/" class="brand">
      <Logo size={32} />
      <span>{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-outline-variant);
    background: var(--color-surface);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 64px;
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--color-on-surface);
    text-decoration: none;
  }
  ul {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--color-on-surface-variant);
    text-decoration: none;
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--color-primary);
  }
  @media (max-width: 480px) {
    ul {
      gap: var(--space-4);
    }
    nav a {
      font-size: 0.875rem;
    }
  }
</style>
