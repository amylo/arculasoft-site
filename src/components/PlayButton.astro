---
import type { Product } from '../lib/site';

interface Props {
  product: Product;
  variant?: 'primary' | 'on-dark';
}
const { product, variant = 'primary' } = Astro.props;
const cls = `button button-${variant}`;
---

{
  product.playStoreUrl ? (
    <a class={cls} href={product.playStoreUrl} rel="noopener">
      Get it on Google Play
    </a>
  ) : (
    <span class={cls} aria-disabled="true">
      Coming soon to Google Play
    </span>
  )
}
