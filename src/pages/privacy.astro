---
import Base from '../layouts/Base.astro';
import ProductNav from '../components/ProductNav.astro';
import PrivacyPolicy from '../components/PrivacyPolicy.astro';

// This URL (/privacy/) is the one given to app stores; keep it stable. It is the
// canonical copy; /arcula/privacy/ renders the same policy and points here.
---

<Base
  title="Arcula privacy policy"
  description="How Arcula handles your information: it stays on your device."
>
  <ProductNav slot="subnav" />
  <PrivacyPolicy />
</Base>
