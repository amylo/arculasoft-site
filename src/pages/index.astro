---
import Base from '../layouts/Base.astro';
import ArculaLogo from '../components/ArculaLogo.astro';
import { company, products } from '../lib/site';
---

<Base>
  <section class="hero">
    <div class="container">
      <h1>{company.tagline}</h1>
      {company.about.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section id="products" class="products" aria-labelledby="products-heading">
    <div class="container">
      <h2 id="products-heading">Products</h2>
      <ul class="grid">
        {
          products.map((p) => (
            <li>
              <a class="card" href={p.path}>
                <ArculaLogo size={64} />
                <div>
                  <p class="category">{p.category}</p>
                  <h3>{p.name}</h3>
                  <p class="tagline">{p.tagline}</p>
                  <p class="description">{p.description}</p>
                  <p class="meta">
                    <span>{p.platforms}</span>
                    <span class="more">Learn more →</span>
                  </p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="contact" aria-labelledby="contact-heading">
    <div class="container">
      <h2 id="contact-heading">Contact</h2>
      <p>
        Questions or feedback? Email <a href={`mailto:${company.contactEmail}`}>{company.contactEmail}</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-10);
  }
  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    max-width: 16em;
    margin: 0 0 var(--space-6);
  }
  .hero p {
    font-size: 1.15rem;
    color: var(--color-on-surface-variant);
    max-width: 42em;
    margin: 0 0 var(--space-4);
  }

  section h2 {
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    margin: 0 0 var(--space-6);
  }
  .products {
    padding-block: var(--space-10);
    background: var(--color-surface-container-low);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: var(--space-5);
  }
  .card {
    display: flex;
    gap: var(--space-5);
    height: 100%;
    background: var(--color-surface-container-lowest);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    color: var(--color-on-surface);
    text-decoration: none;
    transition: border-color var(--motion-duration-quick) var(--motion-easing-standard);
  }
  .card:hover {
    border-color: var(--color-primary);
  }
  .card p {
    margin: 0;
  }
  .category {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
  }
  .card h3 {
    margin: var(--space-1) 0;
    font-size: 1.4rem;
  }
  .tagline {
    font-weight: 700;
  }
  .description {
    color: var(--color-on-surface-variant);
    margin-top: var(--space-2) !important;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4) !important;
    font-size: 0.9rem;
    color: var(--color-on-surface-variant);
  }
  .more {
    font-weight: 700;
    color: var(--color-primary);
  }

  .contact {
    padding-block: var(--space-9);
  }
  .contact p {
    margin: 0;
  }

  @media (max-width: 480px) {
    .card {
      flex-direction: column;
      gap: var(--space-4);
    }
  }
</style>
